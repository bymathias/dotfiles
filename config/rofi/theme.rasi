/**
 * Rofi theme — dark grey palette
 * Matches Waybar, Mako, and Foot themes
 * Optimized for Arch Linux with Sway on Asus Vivobook S 14 OLED
 * Rofi version: 2.0.0
 */

* {
    /* Color palette */
    clr-bg:     #1C2526;
    clr-bg2:    #2E3536;
    clr-border: #40494A;
    clr-dim:    #596162;
    clr-mid:    #727B7C;
    clr-fg:     #8A9394;

    font: "monospace 14";
    red:                         @clr-mid;
    selected-active-foreground:  @clr-bg;
    lightfg:                     @clr-dim;
    separatorcolor:              @clr-border;
    urgent-foreground:           @clr-mid;
    alternate-urgent-background: @clr-bg2;
    lightbg:                     @clr-bg2;
    background-color:            transparent;
    border-color:                @clr-border;
    normal-background:           @clr-bg;
    selected-urgent-background:  @clr-mid;
    alternate-active-background: @clr-bg2;
    spacing:                     2;
    blue:                        @clr-mid;
    alternate-normal-foreground: @clr-fg;
    urgent-background:           @clr-bg;
    selected-normal-foreground:  @clr-bg2;
    active-foreground:           @clr-mid;
    background:                  @clr-bg;
    selected-active-background:  @clr-mid;
    active-background:           @clr-bg;
    selected-normal-background:  @clr-dim;
    alternate-normal-background: @clr-bg2;
    foreground:                  @clr-fg;
    selected-urgent-foreground:  @clr-bg;
    normal-foreground:           @clr-fg;
    alternate-urgent-foreground: @clr-mid;
    alternate-active-foreground: @clr-mid;
}

element {
    padding: 1px;
    cursor:  pointer;
    spacing: 5px;
    border:  0;
}

element normal.normal {
    background-color: @clr-bg;
    text-color:       @clr-fg;
}

element normal.urgent {
    background-color: @clr-bg;
    text-color:       @clr-mid;
}

element normal.active {
    background-color: @clr-bg;
    text-color:       @clr-mid;
}

element selected.normal {
    background-color: @clr-dim;
    text-color:       @clr-bg2;
}

element selected.urgent {
    background-color: @clr-mid;
    text-color:       @clr-bg;
}

element selected.active {
    background-color: @clr-mid;
    text-color:       @clr-bg;
}

element alternate.normal {
    background-color: @clr-bg2;
    text-color:       @clr-fg;
}

element alternate.urgent {
    background-color: @clr-bg2;
    text-color:       @clr-mid;
}

element alternate.active {
    background-color: @clr-bg2;
    text-color:       @clr-mid;
}

element-text {
    background-color: transparent;
    cursor:           inherit;
    highlight:        inherit;
    text-color:       inherit;
}

element-icon {
    background-color: transparent;
    size:             1.0000em;
    cursor:           inherit;
    text-color:       inherit;
}

window {
    padding:          5;
    background-color: @clr-bg;
    border:           1;
    border-color:     @clr-border;
}

mainbox {
    padding: 0;
    border:  0;
}

message {
    padding:      1px;
    border-color: @clr-border;
    border:       2px dash 0px 0px;
}

textbox {
    text-color: @clr-fg;
}

listview {
    padding:      2px 0px 0px;
    scrollbar:    true;
    border-color: @clr-border;
    spacing:      2px;
    fixed-height: 0;
    border:       2px dash 0px 0px;
}

scrollbar {
    width:        4px;
    padding:      0;
    handle-width: 8px;
    border:       0;
    handle-color: @clr-fg;
}

sidebar {
    border-color: @clr-border;
    border:       2px dash 0px 0px;
}

button {
    cursor:     pointer;
    spacing:    0;
    text-color: @clr-fg;
}

button selected {
    background-color: @clr-dim;
    text-color:       @clr-bg2;
}

num-filtered-rows {
    expand:     false;
    text-color: @clr-dim;
}

num-rows {
    expand:     false;
    text-color: @clr-dim;
}

textbox-num-sep {
    expand:     false;
    str:        "/";
    text-color: @clr-dim;
}

inputbar {
    padding:    1px;
    spacing:    0px;
    text-color: @clr-fg;
    children:   [ prompt, textbox-prompt-colon, entry, overlay, num-filtered-rows, textbox-num-sep, num-rows, case-indicator ];
}

overlay {
    padding:          0px 0.2000em;
    background-color: @clr-fg;
    text-color:       @clr-bg;
}

case-indicator {
    spacing:    0;
    text-color: @clr-fg;
}

entry {
    text-color:        @clr-fg;
    cursor:            text;
    spacing:           0;
    placeholder-color: @clr-dim;
    placeholder:       "Type to filter";
}

prompt {
    spacing:    0;
    text-color: @clr-fg;
}

textbox-prompt-colon {
    margin:     0px 0.3000em 0.0000em 0.0000em;
    expand:     false;
    str:        ":";
    text-color: inherit;
}
