#
# Configure Application Scaling for HiDPi Oled screen (2880x1800)
#

# GTK Apps: Set scaling for GTK apps (e.g., Thunar)
# Qt Apps: For Qt apps (e.g., qBittorrent)
# Firefox: Enable Wayland and scaling
#exec dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=sway
exec dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=sway GTK_THEME ICON_THEME XCURSOR_THEME XCURSOR_SIZE
set $env GDK_SCALE=1.75
set $QT_QPA_PLATFORM wayland
set $env QT_SCALE_FACTOR=1.75
set $env MOZ_ENABLE_WAYLAND=1
#set $env GTK_THEME=Arc-Dark
#set $env XCURSOR_THEME=Arc
#set $env XCURSOR_SIZE=36

#
# Window layouts
#

# Remove borders but still indicate the focused window
# Default 1px border (all sides) for tiled windows
default_border pixel 1
# Hide borders on single-window workspaces for "fullscreen-like" single windows
smart_borders on
# Hide edge borders to avoid double-borders at screen edges (optional but recommended)
#hide_edge_borders both

# Gaps: Equal between windows (inner) and screen edges (outer)
gaps inner 5
gaps outer 1
# Optional: Smart gaps (auto-disable on single window; keeps outer gaps)
#smart_gaps on

# For per application settings, set
#for_window [app_id="firefox"] border none

# Floating Window
# Open File Operation Progress
for_window [title="File Operation Progress"] floating enable
for_window [title="Rename.*"] floating enable
# Open Thunderbird Write Window
for_window [app_id="org.mozilla.Thunderbird" title="^Write:"] floating enable, resize set 1000 800, move position center
# Open Youtube/Plex video and make it sticky on all workspace
for_window [app_id="firefox" title="Picture-in-Picture"] floating toggle, sticky toggle, resize set 960 540, move position 480 360

#
# Autostart
#

# Better Wayland app integration (e.g., screen sharing)
#sudo pacman -S xdg-desktop-portal-wlr
exec xdg-desktop-portal-wlr

# Notifications
exec mako

# Waybar Tray
# Starts NetworkManagerApplet for Networks
exec_always --no-startup-id nm-applet --indicator
# Blueman for Bluetooth
exec_always --no-startup-id blueman-applet
# Dropbox
exec_always --no-startup-id dropbox

# For automatic tiling (e.g., always vertical after two windows)
exec_always autotiling

# Ensure Transmission handles magnet links
exec_always xdg-settings set default-url-scheme-handler magnet transmission-gtk.desktop

# Get a notification when the Proton Drive mounts
exec systemctl --user start rclone-proton.service && \
  notify-send "Proton Drive" "Mounted successfully" --icon=drive-harddisk

# Udisks frontend
exec udiskie &

include /etc/sway/config.d/*
